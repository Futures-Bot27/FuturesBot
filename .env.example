# --- TradersPost (executes on your linked Tradeify/Tradovate account) ---
TRADERSPOST_WEBHOOK_URL=            # from your TradersPost strategy dashboard

# --- Instrument 1: MGC (Micro Gold) ---
# Leave MGC_TICKER blank to disable this instrument entirely.
MGC_TICKER=                         # e.g. MGCZ2026 -- confirm exact format via
                                     # TradersPost's "Submit Signal" tool
MGC_TWELVE_DATA_SYMBOL=XAU/USD
MGC_MULTIPLIER=10                   # $ per $1 gold move, per contract
MGC_FEE_ROUND_TRIP=2.50
MGC_RISK_SHARE=0.5                  # this instrument's share of the shared risk budget
MGC_ORDER_QTY=1

# --- Instrument 2: MNQ (Micro Nasdaq-100) ---
# Leave MNQ_TICKER blank to disable this instrument entirely.
MNQ_TICKER=                         # e.g. MNQU2026 -- confirm exact format via
                                     # TradersPost's "Submit Signal" tool
MNQ_TWELVE_DATA_SYMBOL=QQQ          # NDX (raw index) needs a paid Twelve Data
                                     # plan -- QQQ ETF tracks Nasdaq-100 closely
                                     # and works on lower-tier plans
MNQ_MULTIPLIER=2                    # $ per index point, per contract
MNQ_FEE_ROUND_TRIP=1.50
MNQ_RISK_SHARE=0.5                  # MGC_RISK_SHARE + MNQ_RISK_SHARE should sum to <= 1.0
MNQ_ORDER_QTY=1

# --- Equity estimation (see equity_tracker.py -- no live broker read available) ---
STARTING_BALANCE=50207.14           # your real balance NOW -- reconcile via
                                     # POST /reconcile whenever you check the
                                     # real Tradeify dashboard

# --- Trading params (shared across all instruments) ---
SIGNAL_INTERVAL=15min
LOOP_SECONDS=60
MIN_CONFLUENCE_SCORE=3
DRY_RUN=true                        # MUST be false to send real orders

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
